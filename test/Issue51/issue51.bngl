begin model

begin molecule types
  A(x,z)
  B(y,w)
end molecule types

begin seed species
  A(x,z!1).B(y,w!1) 1
end seed species

begin observables
  Molecules bound A(x!1).B(y!1)
end observables

begin reaction rules
  A(x) + B(y) -> A(x!2).B(y!2) 1
end reaction rules

end model

begin actions
  writeXML()
end actions
